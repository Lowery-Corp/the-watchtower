WATCHTOWER_ENVIRONMENT=local
WATCHTOWER_FRONTEND_PORT=5174
# FastAPI and PostgreSQL are bound to host loopback only; remote API callers require a trusted TLS ingress.
WATCHTOWER_API_PORT=8001
# Global body limit enforced by the public frontend API proxy (256 KiB by default).
WATCHTOWER_MAX_REQUEST_BODY_BYTES=262144
WATCHTOWER_POSTGRES_DB=watchtower
WATCHTOWER_POSTGRES_USER=watchtower
WATCHTOWER_POSTGRES_PASSWORD=change-me
WATCHTOWER_DATABASE_URL=postgresql+asyncpg://watchtower:change-me@db:5432/watchtower
WATCHTOWER_AUTH_SERVICE_URL=https://dauth.johnmgrubbs.io
WATCHTOWER_AUTH_SERVICE_TIMEOUT_SECONDS=5
WATCHTOWER_SESSION_COOKIE_NAME=watchtower_session
WATCHTOWER_SESSION_COOKIE_MAX_AGE_SECONDS=3600
WATCHTOWER_SESSION_COOKIE_SECURE=false
WATCHTOWER_SESSION_COOKIE_SAME_SITE=lax
WATCHTOWER_BROWSER_ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","https://dwatchtower.johnmgrubbs.io"]
WATCHTOWER_WEBHOOK_SECRETS={}
WATCHTOWER_LEGACY_WEBHOOK_PROFILES={}
WATCHTOWER_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WATCHTOWER_MAX_WEBHOOK_BODY_BYTES=262144
WATCHTOWER_WEBHOOK_RATE_LIMIT_REQUESTS=60
WATCHTOWER_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# Website uptime worker defaults
WATCHTOWER_UPTIME_CHECK_INTERVAL_SECONDS=60
WATCHTOWER_UPTIME_CHECK_TIMEOUT_SECONDS=10
WATCHTOWER_UPTIME_WORKER_BATCH_SIZE=50
WATCHTOWER_UPTIME_WORKER_CONCURRENCY=10
WATCHTOWER_UPTIME_HISTORY_RETENTION_DAYS=30
WATCHTOWER_UPTIME_WORKER_POLL_SECONDS=5
WATCHTOWER_UPTIME_MAX_ACTIVE_MONITORS_PER_PROFILE=100
WATCHTOWER_UPTIME_MONITOR_CREATE_RATE_LIMIT_REQUESTS=20
WATCHTOWER_UPTIME_MONITOR_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
